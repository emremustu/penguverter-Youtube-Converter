{
  "name": "penguverter",
  "version": "1.0.0",
  "main": "main.cjs",
  "type": "module",
  "description": "Penguverter MP3/MP4 converter",
  "author": {
    "name": "Yusuf Emre Muştu",
    "email": "yusufemremustu@gmail.com"
  },
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "concurrently \"vite\" \"electron .\"",
    "build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.penguverter.app",
    "productName": "Penguverter",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.js",
      "dist/**/*",
      "bin/**/*",
      "assets/**/*"
    ],
     "extraResources": [
    {
      "from": "bin/",
      "to": "bin",
      "filter": ["**/*"]
    }
  ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/Penguverter.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-is-dev": "^3.0.0",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "wait-on": "^9.0.4"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron-builder": "^26.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1"
  }
}